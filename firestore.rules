rules_version = '2';
// กฎความปลอดภัยของฐานข้อมูล: คัดลอกทั้งไฟล์ไปวางในแท็บ Rules ของ Firestore (README ข้อ 2.4)
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      // ใครที่เปิดเว็บ (ล็อกอินแบบไม่ระบุตัวตนอัตโนมัติ) อ่านห้องได้ถ้ารู้รหัส
      allow get: if request.auth != null;
      // รายการห้อง: ดูได้เฉพาะห้องที่ตัวเองอยู่
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      // สร้างห้อง: ต้องเป็นเจ้าของห้องเอง และเอกสารไม่ใหญ่เกินไป
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids.hasOnly([request.auth.uid]);
      // แก้ไขห้อง: คนที่อยู่ในห้องแล้ว หรือคนที่กำลังเข้าร่วมตอนห้องยังรอผู้เล่น
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.uids ||
        (resource.data.status == 'lobby' && request.auth.uid in request.resource.data.uids)
      ) && request.resource.data.host == resource.data.host;
      // ลบห้อง: เจ้าของห้องเท่านั้น
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
  }
}
